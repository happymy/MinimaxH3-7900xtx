 import torch
 from PIL import Image
 from comfy.cli_args import args, LatentPreviewMethod
 from comfy.taesd.taesd import TAESD
 from comfy.sd import VAE
 import comfy.model_management
 import comfy.model_prefetch
 import folder_paths
 import comfy.utils
 import logging
 
 default_preview_method = args.preview_method
 
+# H3 视频帧预览：采样中用工作流的 video VAE 解码真实帧落盘（MiniMaxH3ReferenceToVideo 注册 VAE，
+# execution 按任务设置开关）。文件存 %TEMP%\iw-preview-*，首个任务首帧弹一次资源管理器。
+_frame_preview_enabled = False
+_frame_preview_vae: VAE | None = None
+_frame_preview_dir: str | None = None
+_frame_preview_count = 0
+
+
+def set_frame_preview_enabled(enabled: bool):
+    global _frame_preview_enabled, _frame_preview_dir, _frame_preview_count
+    _frame_preview_enabled = enabled
+    _frame_preview_dir = None
+    _frame_preview_count = 0
+
+
+def set_frame_preview_vae(vae):
+    global _frame_preview_vae
+    _frame_preview_vae = vae
+
+
+def _frame_preview_dir_path() -> str:
+    global _frame_preview_dir
+    if _frame_preview_dir is None:
+        _frame_preview_dir = os.path.join(
+            tempfile.gettempdir(),
+            f"iw-preview-{time.strftime('%m%d%H%M%S')}-{os.getpid() % 100000:05d}",
+        )
+        os.makedirs(_frame_preview_dir, exist_ok=True)
+        os.startfile(_frame_preview_dir)
+    return _frame_preview_dir
+
+
+def _save_frame_preview(x0_video: torch.Tensor, step: int):
+    """解码中间 1/3 时间窗的真帧，均匀取 6 帧保存（约每秒 3 帧），封面本任务的唯一文件夹。"""
+    global _frame_preview_count
+    vae = _frame_preview_vae
+    t = x0_video.shape[2]
+    t0, t1 = t // 3, t - t // 3
+    if t1 - t0 < 5:
+        t0, t1 = 0, max(5, t)
+    frames = vae.decode(x0_video[:, :, t0:t1])
+    n = frames.shape[1]
+    dir_path = _frame_preview_dir_path()
+    for i in {round(k * (n - 1) / 5) for k in range(6)}:
+        img = frames[0, i]
+        img = img.float().clamp(0, 1).mul(255).to(dtype=torch.uint8)
+        Image.fromarray(img.cpu().numpy()).save(
+            os.path.join(dir_path, f"step{step:03d}_f{i:02d}.jpg"), quality=90
+        )
+    _frame_preview_count += 1
+    logging.info(
+        f"frame preview: step {step}/{_frame_preview_count} decoded {n} frames -> "
+        f"{dir_path} (t {t0}:{t1} of {t})"
+    )
+
